<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that can be tested without a window: finding and running
       the CLI, reading its status, the expiry rules, the sign-in state
       machines, release checks, and launch at login. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>VarlatchKit</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VarlatchKit.Tests" />
  </ItemGroup>

</Project>
