<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Varlatch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Session colors: green while live, amber while expiring, red once expired or for errors. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VarlatchOkBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="VarlatchExpiringBrush" Color="#B35A00" />
                    <SolidColorBrush x:Key="VarlatchErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="VarlatchOkDotBrush" Color="#2DA44E" />
                    <SolidColorBrush x:Key="VarlatchExpiringDotBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="VarlatchErrorDotBrush" Color="#E5484D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VarlatchOkBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="VarlatchExpiringBrush" Color="#FFA43D" />
                    <SolidColorBrush x:Key="VarlatchErrorBrush" Color="#FF7A6E" />
                    <SolidColorBrush x:Key="VarlatchOkDotBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="VarlatchExpiringDotBrush" Color="#FFA43D" />
                    <SolidColorBrush x:Key="VarlatchErrorDotBrush" Color="#FF6B5E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The panel and Settings are built in code; these styles carry
                 the theme, so both follow light and dark mode as it changes. -->
            <Style x:Key="VarlatchTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="VarlatchBodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="VarlatchCaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="VarlatchOkText" TargetType="TextBlock" BasedOn="{StaticResource VarlatchCaptionText}">
                <Setter Property="Foreground" Value="{ThemeResource VarlatchOkBrush}" />
            </Style>
            <Style x:Key="VarlatchExpiringText" TargetType="TextBlock" BasedOn="{StaticResource VarlatchCaptionText}">
                <Setter Property="Foreground" Value="{ThemeResource VarlatchExpiringBrush}" />
            </Style>
            <Style x:Key="VarlatchErrorText" TargetType="TextBlock" BasedOn="{StaticResource VarlatchCaptionText}">
                <Setter Property="Foreground" Value="{ThemeResource VarlatchErrorBrush}" />
            </Style>
            <Style x:Key="VarlatchCodeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="VarlatchCommandText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="VarlatchSecondaryGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="VarlatchExpiringGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource VarlatchExpiringBrush}" />
            </Style>
            <Style x:Key="VarlatchOkGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource VarlatchOkBrush}" />
            </Style>
            <Style x:Key="VarlatchErrorGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource VarlatchErrorBrush}" />
            </Style>
            <Style x:Key="VarlatchSecondaryIcon" TargetType="BitmapIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="VarlatchOkDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource VarlatchOkDotBrush}" />
            </Style>
            <Style x:Key="VarlatchExpiringDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource VarlatchExpiringDotBrush}" />
            </Style>
            <Style x:Key="VarlatchErrorDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource VarlatchErrorDotBrush}" />
            </Style>
            <Style x:Key="VarlatchDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="VarlatchCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,10,12,10" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="VarlatchSettingsCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="VarlatchQrFrame" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="White" />
            </Style>
            <Style x:Key="VarlatchButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="11,4,11,5" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="VarlatchAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="11,4,11,5" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="VarlatchSubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="7,5,7,5" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
